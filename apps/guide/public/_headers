# Cloudflare Pages reads this file. Paths below are relative to the site root.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Files in /assets have a fingerprint in their name, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The page itself is re-checked each visit so a newly published recipe shows up.
/index.html
  Cache-Control: no-cache
