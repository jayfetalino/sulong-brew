# Cloudflare Pages reads this file. Paths below are relative to the site root.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow

# App icons are not pages, so they do not need the search-engine rule above.
/icons/*
  ! X-Robots-Tag
/apple-touch-icon*.png
  ! X-Robots-Tag

# Files in /assets have a fingerprint in their name, so they can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These must always be re-checked, or a new version of the app would never arrive.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
